# ---- CALL-E (voice) ----
# Get this from `calle auth login` / the CALL-E dashboard.
CALLE_API_KEY=
# Per-request webhook signing secret (CALL-E dashboard → webhooks).
CALLE_WEBHOOK_SECRET=

# ---- Supabase (DB) ----
SUPABASE_URL=
# Service-role key is server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Client-side auth (browser). Safe to expose — publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Gemini (fallback extraction / enrichment) ----
GEMINI_API_KEY=

# ---- App ----
# Public base URL CALL-E will call back on. In dev, use an ngrok/tunnel URL.
APP_URL=http://localhost:3000

# ---- Supplya integration ----
# Shared secret Supplya must send as `x-cierge-secret` on the signup webhook.
SUPPLYA_WEBHOOK_SECRET=
